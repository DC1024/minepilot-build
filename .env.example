# Optional process-only development fallback. Never commit a populated .env.
MCAI_API_KEY=

# Preferred for headless servers and containers: point at a mounted, read-only
# secret. systemd LoadCredential is also discovered automatically as
# $CREDENTIALS_DIRECTORY/mcai-api-key.
MCAI_API_KEY_FILE=

# Optional fixed local MCP token: 32-128 URL-safe characters.
MCAI_MCP_TOKEN=
